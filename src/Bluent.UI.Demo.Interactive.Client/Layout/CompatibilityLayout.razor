@inherits LayoutComponentBase

@* #425 compatibility host must paint the same theme it uses for text.
   A white body with dark-theme white text made real RTL screenshots unreadable. *@
<main style="max-width: 72rem; margin: 0 auto; padding: min(2rem, 4vw); min-height: 100vh; background-color: var(--colorNeutralBackground1); color: var(--colorNeutralForeground1);">
    @Body
</main>
