@page "/components/numeric-fields-server"
@rendermode InteractiveServer
@layout Bluent.UI.Demo.Interactive.Client.Layout.CompatibilityLayout
@using Bluent.UI.Demo.Pages.Components

@* Reuse the exact NumericFields showcase inside a real InteractiveServer circuit. *@
<Containers />
<NumericFields />
<div id="numericfield-interactive-ready" data-ready="@(_interactiveReady ? "true" : "false")" hidden></div>

@code {
    private bool _interactiveReady;

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _interactiveReady = true;
            StateHasChanged();
        }

        return Task.CompletedTask;
    }
}
