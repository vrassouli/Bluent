@page "/components/diagrams"
@namespace Bluent.UI.Demo.Pages.Components
@using Bluent.UI.Diagrams.Tools.Drawings.Diagram

<div class="p-5 pb-3">
    <ShowcaseHeader Title="Diagrams"
                    Purpose="Build interactive process and relationship canvases with drawing tools, selection, connectors, undo/redo, panning, scaling, and deletion."
                    Package="Bluent.UI.Diagrams"
                    Namespace="Bluent.UI.Diagrams.Components"
                    ApiSummary="Diagram, Tool, CommandManager, Selection, AllowDrag/Pan/Scale/Delete, SVG definitions, nodes, and connectors."
                    SourcePath="Diagrams.razor"
                    Notes="This is an editor surface, not a static image. Select a drawing tool, place nodes, connect them, and exercise undo/redo; keyboard and touch needs should be reviewed for the target workflow." />
</div>

<Toolbar>
    <ToolbarButton Icon="icon-ic_fluent_cursor_20_regular" ActiveIcon="@(_tool is null ? "icon-ic_fluent_cursor_20_regular" : "icon-ic_fluent_cursor_20_filled")" OnClick="DeselectTool" Toggled="@(_tool is null)" aria-label="Pointer tool" />

    <ToolbarButton Icon="icon-ic_fluent_circle_hint_cursor_20_regular" OnClick="SelectAreaSelectTool" Toggled="@(_tool is DiagramAreaSelectTool)" aria-label="Area selection tool" />
    <ToolbarDivider />
    <ToolbarButton Icon="icon-ic_fluent_arrow_undo_20_regular" OnClick="Undo" disabled="@(!_canUndo)" aria-label="Undo" />
    <ToolbarButton Icon="icon-ic_fluent_arrow_redo_20_regular" OnClick="Redo" disabled="@(!_canRedo)" aria-label="Redo" />
    <ToolbarButton Tooltip="Rectangle" Icon="icon-ic_fluent_rectangle_landscape_20_regular" OnClick="SelectRectTool" Toggled="@(_tool is DrawRectangleNodeTool)" aria-label="Rectangle tool" />
    <ToolbarButton Tooltip="Circle" Icon="icon-ic_fluent_circle_20_regular" OnClick="SelectCircleTool" Toggled="@(_tool is DrawCircleNodeTool)" aria-label="Circle tool" />
    <ToolbarDivider />
    <ToolbarButton Tooltip="Boundary Circle" Icon="icon-ic_fluent_circle_multiple_concentric_20_regular" OnClick="SelectBoundaryCircleTool" Toggled="@(_tool is DrawBoundaryCircleNodeTool)" aria-label="Boundary circle tool" />
    <ToolbarDivider />
    <ToolbarButton Tooltip="Rectangle Container" Icon="icon-ic_fluent_rectangle_landscape_20_regular" OnClick="SelectRectContainerTool" Toggled="@(_tool is DrawRectangleContainerNodeTool)" aria-label="Rectangle container tool" />
    <ToolbarDivider />
    <ToolbarButton Tooltip="Connector" Icon="icon-ic_fluent_arrow_flow_diagonal_up_right_20_regular" OnClick="SelectConnectorTool" Toggled="@(_tool is DrawDiagramConnectorTool)" aria-label="Connector tool" />

</Toolbar>

<Stack Orientation="Orientation.Horizontal" Class="flex-fill">
    <Stack Orientation="Orientation.Vertical" Class="gap-1" HorizontalAlignment="StackAlignment.Start">
        Side...
    </Stack>

    <Diagram Class="flex-fill"
             Style="height: 500px"
             Tool="Tool"
             CommandManager="_commandManager"
             Selection="Core.SelectionMode.Multiple"
             AllowDrag
             AllowPan
             AllowScale
             AllowDelete>
        <Defs>
            <pattern id="grid-pattern" patternUnits="userSpaceOnUse" width="10" height="10">
                <circle cx="0" cy="0" r="0.5" stroke-width="0.5" stroke="none" fill="var(--colorNeutralStrokeAccessible)"></circle>
                <circle cx="0" cy="10" r="0.5" stroke-width="0.5" stroke="none" fill="var(--colorNeutralStrokeAccessible)"></circle>
                <circle cx="10" cy="10" r="0.5" stroke-width="0.5" stroke="none" fill="var(--colorNeutralStrokeAccessible)"></circle>
                <circle cx="10" cy="0" r="0.5" stroke-width="0.5" stroke="none" fill="var(--colorNeutralStrokeAccessible)"></circle>
            </pattern>
        </Defs>
        <ChildContent>
            <rect width="100%" height="100%" fill="url(#grid-pattern)"></rect>
        </ChildContent>
    </Diagram>
</Stack>
