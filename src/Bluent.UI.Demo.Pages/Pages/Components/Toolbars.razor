@page "/components/toolbars"
@namespace Bluent.UI.Demo.Pages.Components

<div class="p-5 py-md-10 px-md-12">
    <div class="w-100 w-md-50 m-auto">
        <h1>Toolbars</h1>

        <h3>Default</h3>
        <section class="p-7 rounded-5 shadow-3">
            <Label Text="Toolbar width (px):" Class="me-4" />
            <NumericField @bind-Value="_horizontalToolbarWidth" />
            <Checkbox @bind-Value="_disabledItems" Label="Disabled Items"/>
            <Toolbar Class="my-4 shadow-2" Style="@HorizontalToolbarWidth">
                <ToolbarButton MenuLabel="Backward" Icon="@FluentIcons.ArrowCircleLeft" OnClick="@(()=>{SetMessage("Backward"); })">
                    <Dropdown>
                        <MenuList>
                            <MenuItem Title="Document 1" OnClick="@(()=>{SetMessage("Document 1"); })" />
                            <MenuItem Title="Document 2" OnClick="@(()=>{SetMessage("Document 2"); })" />
                            <MenuItem Title="Document 3" OnClick="@(()=>{SetMessage("Document 3"); })" />
                        </MenuList>
                    </Dropdown>
                </ToolbarButton>
                <ToolbarButton MenuLabel="Forward" Icon="@FluentIcons.ArrowCircleRight">
                    <Dropdown>
                        <MenuList>
                            <MenuItem Title="Document 5" OnClick="@(()=>{SetMessage("Document 5"); })" />
                            <MenuItem Title="Document 6" OnClick="@(()=>{SetMessage("Document 6"); })" />
                            <MenuItem Title="Document 7" OnClick="@(()=>{SetMessage("Document 7"); })" />
                        </MenuList>
                    </Dropdown>
                </ToolbarButton>
                <ToolbarDivider />
                <ToolbarButton Text="Open" Icon="@FluentIcons.FolderOpen" Appearance="ToolbarButtonAppearance.Primary" OnClick="@(()=>{SetMessage("Open"); })" />
                <ToolbarButton Text="Save" Icon="@FluentIcons.Save" OnClick="@(()=>{SetMessage("Save"); })" />
                <ToolbarButton Text="Save All" Icon="@FluentIcons.SaveMultiple" OnClick="@(()=>{SetMessage("Save All"); })" />
                <ToolbarDivider />
                <ToolbarButton Text="Undo" Icon="@FluentIcons.ArrowUndo" disabled="@_disabledItems" OnClick="@(()=>{SetMessage("Undo"); })" />
                <ToolbarButton Text="Redo" Icon="@FluentIcons.ArrowRedo" disabled="@_disabledItems" OnClick="@(()=>{SetMessage("Redo"); })" />
                <ToolbarDivider />
                <ToolbarButton MenuLabel="Cut" Icon="@FluentIcons.Cut" Appearance="ToolbarButtonAppearance.Subtle" OnClick="@(()=>{SetMessage("Cut"); })" Tooltip="Cut" />
                <ToolbarButton MenuLabel="Copy" Icon="@FluentIcons.Copy" Appearance="ToolbarButtonAppearance.Subtle" OnClick="@(()=>{SetMessage("Copy"); })" Tooltip="Copy" />
                <ToolbarButton MenuLabel="Paste" Icon="@FluentIcons.ClipboardPaste" Appearance="ToolbarButtonAppearance.Subtle" OnClick="@(()=>{SetMessage("Paste"); })" Tooltip="Paste" />
                <ToolbarDivider />
                <ToolbarButton Text="Quick Actions" OnClick="@(()=>{SetMessage("Quick Actions"); })" />
                <ToolbarDivider />
                <ToolbarButton Text="Learn" Icon="@FluentIcons.HatGraduation" Href="https://learn.microsoft.com/en-us/" target="_blank" />
            </Toolbar>

            <div>
                @_message
            </div>
        </section>

        <h3>Vertical</h3>
        <section class="p-7 rounded-5 shadow-3">
            <Label Text="Toolbar height (px):" Class="me-4" />
            <NumericField @bind-Value="_verticalToolbarHeight" />

            <Toolbar Orientation="Orientation.Vertical" Class="my-4 shadow-2" Style="@VerticalToolbarHeight">
                <ToolbarButton Text="Open" Icon="@FluentIcons.FolderOpen" Appearance="ToolbarButtonAppearance.Primary" />
                <ToolbarButton Text="Save" Icon="@FluentIcons.Save" />
                <ToolbarButton Text="Save All" Icon="@FluentIcons.SaveMultiple" />
                <ToolbarDivider />
                <ToolbarButton MenuLabel="Cut" Icon="@FluentIcons.Cut" Tooltip="Cut" Appearance="ToolbarButtonAppearance.Subtle" />
                <ToolbarButton MenuLabel="Copy" Icon="@FluentIcons.Copy" Tooltip="Copy" Appearance="ToolbarButtonAppearance.Subtle" />
                <ToolbarButton MenuLabel="Paste" Icon="@FluentIcons.ClipboardPaste" Tooltip="Paste" Appearance="ToolbarButtonAppearance.Subtle" />
                <ToolbarDivider />
                <ToolbarButton Text="Quick Actions" />
            </Toolbar>
        </section>

    </div>
</div>

@code {
    bool _disabledItems = true;
    int? _horizontalToolbarWidth;
    int? _verticalToolbarHeight;
    string? _message;
    string? HorizontalToolbarWidth => _horizontalToolbarWidth == null ? "" : $"width: {_horizontalToolbarWidth}px";
    string? VerticalToolbarHeight => _verticalToolbarHeight == null ? "" : $"height: {_verticalToolbarHeight}px";

    private void SetMessage(string button)
    {
        _message = $"{button} clicked.";
    }
}
