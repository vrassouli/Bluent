@page "/components/icons"
@namespace Bluent.UI.Demo.Pages.Components
<PageTitle>Icons</PageTitle>

<div class="p-5 py-md-10 px-md-12">
    <div class="w-100 w-md-50 m-auto">
        <h1>Icons</h1>

        <h3>Strongly typed Fluent icons</h3>
        <section class="p-7 rounded-5 shadow-3 d-flex flex-column gap-4">
            <div>
                <h4>Default</h4>
                <Icon Value="@FluentIcons.Settings" Class="fs-6" />
            </div>

            <div>
                <h4>Filled variant</h4>
                <Icon Value="@FluentIcons.Settings" Variant="IconVariant.Filled" Class="fs-6" />
            </div>

            <div>
                <h4>Stateful component</h4>
                <Button Text="Save" Icon="@FluentIcons.Save" />
            </div>
        </section>

        <h3 class="mt-7">Custom sources</h3>
        <section class="p-7 rounded-5 shadow-3 d-flex flex-column gap-4">
            <div>
                <h4>SVG</h4>
                <Icon Value="@CustomSvgIcon" Style="width: 32px; height: 32px;" />
            </div>

            <div>
                <h4>Image</h4>
                <Icon Value="@PowerPointIcon" Style="width: 32px; height: 32px;" />
            </div>
        </section>
    </div>
</div>
