@page "/components/data-pagers"
@namespace Bluent.UI.Demo.Pages.Components

<div class="p-5 py-md-10 px-md-12">
    <div class="w-100 w-md-50 m-auto">
        <ShowcaseHeader Title="Data Pager"
                        Purpose="Move through multi-page result sets with optional first, previous, next, and last-page navigation."
                        Package="Bluent.UI"
                        Namespace="Bluent.UI.Components"
                        ApiSummary="PageCount, Page/PageChanged binding, PageQueryParameter, and page-navigation visibility flags."
                        SourcePath="DataPagers.razor"
                        Notes="PageCount is the number of pages, not the number of records. Query-string integration is demonstrated separately from local binding." />

        <h3>Default</h3>
        <section class="p-7 rounded-5 shadow-3">
            <DataPager PageCount="200" @bind-Page="@_page" ShowFirstPage ShowLastPage ShowNextPage ShowPreviousPage/>
        </section>
        
        <h3>Links</h3>
        <section class="p-7 rounded-5 shadow-3">
            <DataPager PageCount="200" Page="@(Page ?? 1)" PageQueryParameter="page" ShowFirstPage ShowLastPage ShowNextPage ShowPreviousPage/>
        </section>
    </div>
</div>

@code{

    private int _page = 1;
    [Parameter, SupplyParameterFromQuery(Name = "page")] public int? Page { get; set; }


}
