@page "/components/radios"
@namespace Bluent.UI.Demo.Pages.Components
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms

<div class="radio-group-showcase p-5 py-md-10 px-md-12">
    <div class="w-100 w-lg-75 m-auto">
        <h1>RadioGroup</h1>
        <p class="text-secondary">
            Choose one option from a small set of mutually exclusive choices. Each group has its own native name,
            accessible group label, and standard Blazor binding and validation behavior.
        </p>

        <h2 class="h4 mt-5">Independent single-choice groups</h2>
        <p class="text-secondary">These groups intentionally use the same option labels. Changing one must not change the other.</p>
        <section class="p-4 rounded-4 shadow-2 d-grid gap-4">
            <div>
                <RadioGroup id="radio-delivery-window" @bind-Value="_deliveryWindow" Label="Delivery window"
                            aria-describedby="delivery-window-help">
                    <Radio Value="@("Morning")" Label="Morning" />
                    <Radio Value="@("Afternoon")" Label="Afternoon" />
                    <Radio Value="@("Evening")" Label="Evening" />
                </RadioGroup>
                <p id="delivery-window-help" class="text-secondary small mt-2 mb-0">
                    Choose when a delivery should arrive.
                </p>
                <p id="radio-delivery-status" class="small mb-0 mt-2" role="status">
                    Delivery: @_deliveryWindow
                </p>
            </div>

            <div>
                <RadioGroup id="radio-contact-window" @bind-Value="_contactWindow" Label="Preferred contact time">
                    <Radio Value="@("Morning")" Label="Morning" />
                    <Radio Value="@("Afternoon")" Label="Afternoon" />
                    <Radio Value="@("Evening")" Label="Evening" />
                </RadioGroup>
                <p id="radio-contact-status" class="small mb-0 mt-2" role="status">
                    Contact: @_contactWindow
                </p>
            </div>
        </section>

        <h2 class="h4 mt-5">Orientation and label placement</h2>
        <section class="p-4 rounded-4 shadow-2 d-grid gap-4">
            <div>
                <RadioGroup id="radio-priority" @bind-Value="_priority" Label="Priority"
                            Orientation="Orientation.Vertical" ItemsLabelPosition="LabelPosition.Before">
                    <Radio Value="@Priority.High" Label="High" />
                    <Radio Value="@Priority.Normal" Label="Normal" />
                    <Radio Value="@Priority.Low" Label="Low" />
                </RadioGroup>
                <p class="small mt-2 mb-0">Selected priority: @_priority</p>
            </div>
            <div>
                <RadioGroup id="radio-delivery-speed" @bind-Value="_deliverySpeed" Label="Delivery speed" Orientation="Orientation.Vertical">
                    <Radio Value="@("Standard")" Label="Standard" />
                    <Radio Value="@("Express")" Label="Express" disabled />
                    <Radio Value="@("Overnight")" Label="Overnight" />
                </RadioGroup>
                <p class="small mt-2 mb-0">Selected speed: @_deliverySpeed</p>
            </div>
            <div>
                <RadioGroup id="radio-availability" @bind-Value="_availability" Label="Availability">
                    <Radio Value="@("Unavailable")" Label="Unavailable" disabled />
                    <Radio Value="@("Available")" Label="Available" />
                </RadioGroup>
                <p class="small mt-2 mb-0">Selected availability: @_availability</p>
            </div>
        </section>

        <h2 class="h4 mt-5">Accessible name without a visible legend</h2>
        <section class="p-4 rounded-4 shadow-2">
            <RadioGroup id="radio-quiet-hours" @bind-Value="_quietHours"
                        aria-label="Quiet hours preference">
                <Radio Value="@("On")" Label="On" />
                <Radio Value="@("Off")" Label="Off" />
            </RadioGroup>
            <p class="small mt-2 mb-0">Quiet hours: @_quietHours</p>
        </section>

        <h2 class="h4 mt-5">Keyboard entry when no option is selected</h2>
        <section class="p-4 rounded-4 shadow-2">
            <RadioGroup id="radio-alert-frequency" @bind-Value="_alertFrequency" Label="Alert frequency">
                <Radio Value="@("Immediately")" Label="Immediately" />
                <Radio Value="@("Daily")" Label="Daily digest" />
            </RadioGroup>
            <p id="radio-frequency-status" role="status" class="small mt-2 mb-0">Frequency: @_alertFrequency</p>
        </section>

        <h2 class="h4 mt-5">RTL layout</h2>
        <section class="p-4 rounded-4 shadow-2" dir="rtl" lang="fa">
            <RadioGroup id="radio-delivery-language" @bind-Value="_deliveryLanguage"
                        Label="زبان اعلان" Orientation="Orientation.Vertical">
                <Radio Value="@("fa")" Label="فارسی" />
                <Radio Value="@("en")" Label="English" />
            </RadioGroup>
            <p class="small mt-2 mb-0">زبان انتخاب‌شده: @_deliveryLanguage</p>
        </section>

        <h2 class="h4 mt-5">Form binding and validation</h2>
        <section class="p-4 rounded-4 shadow-2">
            <EditForm id="radio-preference-form" Model="_formModel" OnValidSubmit="SubmitForm">
                <DataAnnotationsValidator />
                <RadioGroup id="radio-form-delivery" @bind-Value="_formModel.Delivery"
                            Label="Choose a delivery window" aria-describedby="radio-form-help">
                    <Radio Value="@("Morning")" Label="Morning" />
                    <Radio Value="@("Evening")" Label="Evening" />
                </RadioGroup>
                <p id="radio-form-help" class="text-secondary small mt-2 mb-1">
                    A delivery window is required before this form can be submitted.
                </p>
                <ValidationMessage For="@(() => _formModel.Delivery)" />
                <p id="radio-form-selection" class="small mb-0" aria-live="polite">
                    Selected: @(_formModel.Delivery ?? "None")
                </p>
                <div class="mt-3 d-flex align-items-center gap-3 flex-wrap">
                    <button id="radio-form-submit" type="submit" class="btn btn-primary">Save preference</button>
                    <span id="radio-form-status" role="status" class="small">@_formStatus</span>
                </div>
            </EditForm>
        </section>

        <h2 class="h4 mt-5">Usage</h2>
        <pre class="p-3 rounded-3 bg-body-tertiary"><code>&lt;RadioGroup @@bind-Value="_deliveryWindow" Label="Delivery window"&gt;
    &lt;Radio Value="@("Morning")" Label="Morning" /&gt;
    &lt;Radio Value="@("Evening")" Label="Evening" /&gt;
&lt;/RadioGroup&gt;</code></pre>
        <p class="text-secondary small mt-3">
            Package: <code>Bluent.UI</code> · Namespace: <code>Bluent.UI.Components</code>.
            Use a radio group for a small, visible set; prefer SelectField for longer lists.
        </p>
    </div>
</div>

@code {
    private string _deliveryWindow = "Morning";
    private string _contactWindow = "Evening";
    private string _availability = "Available";
    private string _deliverySpeed = "Standard";
    private string? _alertFrequency;
    private string _quietHours = "Off";
    private string _deliveryLanguage = "fa";
    private Priority _priority = Priority.Normal;
    private string _formStatus = string.Empty;
    private readonly DeliveryPreferenceModel _formModel = new();

    private void SubmitForm()
    {
        _formStatus = $"Saved: {_formModel.Delivery}";
    }

    private enum Priority
    {
        High,
        Normal,
        Low
    }

    private sealed class DeliveryPreferenceModel
    {
        [Required(ErrorMessage = "Choose a delivery window.")]
        public string? Delivery { get; set; }
    }
}
