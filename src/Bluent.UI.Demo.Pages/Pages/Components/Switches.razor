@page "/components/switches"
@namespace Bluent.UI.Demo.Pages.Components
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms

<div class="p-5 py-md-10 px-md-12">
    <div class="w-100 w-md-75 m-auto">
        <ShowcaseHeader Title="Switch"
                        Purpose="Change a binary setting immediately, with a stable accessible name and native keyboard/form behavior."
                        Package="Bluent.UI"
                        Namespace="Bluent.UI.Components"
                        ApiSummary="bool InputBase binding, stable Label, decorative Required marker, and After/Before/Above label placement."
                        SourcePath="Switches.razor"
                        Notes="Switch is for immediately applied settings. Use Checkbox for deferred form choices or nullable/indeterminate state. The first v3 contract uses the Fluent Web Components Medium geometry and no Size parameter." />

        <h3>Immediate Boolean setting</h3>
        <section class="p-7 rounded-5 shadow-3">
            <Switch @bind-Value="_notifications"
                    id="switch-notifications"
                    Label="Notifications"
                    aria-describedby="switch-notifications-state" />
            <p id="switch-notifications-state" class="mt-3 mb-0" role="status">
                Bound value: @(_notifications ? "On" : "Off")
            </p>
            <p class="mt-2 mb-0">The label names the setting and remains unchanged when the value changes.</p>
        </section>

        <h3>Label placement</h3>
        <section class="p-7 rounded-5 shadow-3">
            <div class="mb-4">
                <Switch @bind-Value="_labelAfter" Label="After the switch" LabelPosition="SwitchLabelPosition.After" />
            </div>
            <div class="mb-4">
                <Switch @bind-Value="_labelBefore" Label="Before the switch" LabelPosition="SwitchLabelPosition.Before" />
            </div>
            <div>
                <Switch @bind-Value="_labelAbove" Label="Above the switch" LabelPosition="SwitchLabelPosition.Above" />
            </div>
        </section>

        <h3>Accessible name without a visible label</h3>
        <section class="p-7 rounded-5 shadow-3">
            <Switch @bind-Value="_compactMode" aria-label="Enable compact mode" />
            <p class="mt-3 mb-0">The caller supplies a non-empty accessible name. Do not use an unlabeled Switch without one.</p>
        </section>

        <h3>Disabled states</h3>
        <section class="p-7 rounded-5 shadow-3">
            <div class="mb-3"><Switch Value="false" Label="Disabled and Off" disabled /></div>
            <Switch Value="true" Label="Disabled and On" disabled />
        </section>

        <h3>Required marker and EditForm validation</h3>
        <section class="p-7 rounded-5 shadow-3">
            <EditForm id="switch-validation-form"
                      Model="_validationModel"
                      OnValidSubmit="HandleValidSubmit"
                      OnInvalidSubmit="HandleInvalidSubmit">
                <DataAnnotationsValidator />
                <Switch @bind-Value="_validationModel.Accepted"
                        id="switch-terms"
                        Label="Accept the terms and conditions"
                        Required="*"
                        aria-describedby="switch-terms-help switch-terms-validation" />
                <p id="switch-terms-help" class="mt-2 mb-1">The asterisk is decorative. The DataAnnotations rule owns the actual validation requirement.</p>
                <ValidationMessage For="@(() => _validationModel.Accepted)" id="switch-terms-validation" />
                <button id="switch-validation-submit" type="submit" class="mt-3">Submit</button>
                <p id="switch-validation-status" class="mt-2 mb-0" role="status">@_validationStatus</p>
            </EditForm>
        </section>

        <h3>RTL and Persian labels</h3>
        <section class="p-7 rounded-5 shadow-3" dir="rtl" lang="fa">
            <div class="mb-3">
                <Switch @bind-Value="_rtlUpdates" Label="اعلان‌های مربوط به به‌روزرسانی‌ها" LabelPosition="SwitchLabelPosition.After" />
            </div>
            <Switch @bind-Value="_rtlAccess" Label="دسترسی به قابلیت" LabelPosition="SwitchLabelPosition.Before" />
            <p class="mt-3 mb-0" role="status">@(_rtlUpdates ? "اعلان‌ها روشن است" : "اعلان‌ها خاموش است")</p>
        </section>
    </div>
</div>

@code {
    private bool _notifications;
    private bool _labelAfter;
    private bool _labelBefore;
    private bool _labelAbove;
    private bool _compactMode;
    private bool _rtlUpdates;
    private bool _rtlAccess;

    private readonly SwitchValidationModel _validationModel = new();
    private string _validationStatus = "Submit without accepting to see the validation message.";

    private void HandleValidSubmit() => _validationStatus = "The setting has been accepted.";
    private void HandleInvalidSubmit() => _validationStatus = "Validation failed. Accept the terms before submitting.";

    private sealed class SwitchValidationModel
    {
        [Range(typeof(bool), "true", "true", ErrorMessage = "You must accept the terms and conditions.")]
        public bool Accepted { get; set; }
    }
}
