@page "/components/buttons"
@namespace Bluent.UI.Demo.Pages.Components
<PageTitle>Buttons | Bluent</PageTitle>

<div class="p-5 py-md-10 px-md-12">
    <ShowcaseHeader Title="Buttons and actions"
                    Purpose="Trigger clear business actions, offer alternative choices, and expose compact toolbar commands with consistent appearances and states."
                    Package="Bluent.UI"
                    Namespace="Bluent.UI.Components"
                    ApiSummary="Text, Icon, Appearance, Size, Shape, disabled, Toggled, OnClick, and Href."
                    SourcePath="Buttons.razor"
                    Notes="Examples are interactive and inherit the active theme and direction. Use visible action text for primary workflows; icon-only actions need an accessible label or tooltip." />
    <div>
        <h5>Shapes</h5>
        <div class="d-flex mb-3 gap-2 align-items-center">
            <Button Text="Rounded"/>
            <Button Text="Circular" Shape="ButtonShape.Circular"/>
            <Button Text="Square" Shape="ButtonShape.Square"/>
        </div>
    </div>

    <div>
        <h5>Appearance</h5>
        <div class="d-flex gap-3">
            @foreach (var appearance in Enum.GetValues<ButtonAppearance>())
            {
                <Button Text="@appearance.ToString()"
                        Icon="@FluentIcons.CursorClick"
                        Appearance="@appearance"/>
            }
        </div>
    </div>

    <div>
        <h5>Icon</h5>
        <Button Text="Default" Icon="@FluentIcons.CursorClick"/>
        <Button Icon="@FluentIcons.CursorClick"/>
    </div>

    <div>
        <h5>Size</h5>
        <div class="d-flex mb-3 gap-2 align-items-center">
            <Button Size="ButtonSize.Small" Text="Small"/>
            <Button Size="ButtonSize.Small" Text="Small with icon" Icon="@FluentIcons.CursorClick"/>
            <Button Size="ButtonSize.Small" Icon="@FluentIcons.CursorClick"/>
        </div>
        <div class="d-flex mb-3 gap-2 align-items-center">
            <Button Text="Medium"/>
            <Button Text="Medium with icon" Icon="@FluentIcons.CursorClick"/>
            <Button Icon="@FluentIcons.CursorClick"/>
        </div>
        <div class="d-flex mb-3 gap-2 align-items-center">
            <Button Size="ButtonSize.Large" Text="Large"/>
            <Button Size="ButtonSize.Large" Text="Large with icon" Icon="@FluentIcons.CursorClick"/>
            <Button Size="ButtonSize.Large" Icon="@FluentIcons.CursorClick"/>
        </div>
    </div>

    <div>
        <h5>Disabled</h5>
        <Button Text="Default"/>
        <Button Text="Primary" Appearance="ButtonAppearance.Primary" disabled/>
    </div>

    <div>
        <h5>Link</h5>
        <Button Text="Google" Href="https://google.com"/>
        <Button Text="Google" Href="https://google.com" Appearance="ButtonAppearance.Primary"/>
        <Button Text="Google" Href="https://google.com" disabled/>
    </div>

    <div>
        <h5>Compound</h5>
        <div class="d-flex mb-3 gap-2 align-items-center">
            <Button Text="Rounded" SecondaryText="Compound text" Icon="@FluentIcons.CursorClick"/>
            <Button Text="Circular" SecondaryText="Compound text" Shape="ButtonShape.Circular"
                    Icon="@FluentIcons.CursorClick"/>
            <Button Text="Square" SecondaryText="Compound text" Shape="ButtonShape.Square"
                    Icon="@FluentIcons.CursorClick"/>
        </div>
    </div>

    <div>
        <h5>Toggle</h5>
        <div class="d-flex mb-3 gap-2 align-items-center">
            <Button Toggled="false" Text="Default" Icon="@FluentIcons.CursorClick"/>
            <Button Toggled="false" Text="Primary" Icon="@FluentIcons.CursorClick" Appearance="ButtonAppearance.Primary"/>
            <Button Toggled="false" Text="Outline" Icon="@FluentIcons.CursorClick" Appearance="ButtonAppearance.Outline"/>
            <Button Toggled="false" Text="Subtle" Icon="@FluentIcons.CursorClick" Appearance="ButtonAppearance.Subtle"/>
            <Button Toggled="false" Text="Transparent" Icon="@FluentIcons.CursorClick" Appearance="ButtonAppearance.Transparent"/>
        </div>
    </div>

    <div>
        <h5>Tootip</h5>
        <div class="d-flex mb-3 gap-2 align-items-center">
            <Button Text="Button with tooltip" Icon="@FluentIcons.CursorClick">
                <TooltipContent>
                    This is a tooltip!
                </TooltipContent>
            </Button>
        </div>
    </div>

    <div>
        <h5>Button Group</h5>
        <div class="d-flex mb-3 gap-2 align-items-center">
            <ButtonGroup>
                <Button Icon="@FluentIcons.Cut"/>
                <Button Icon="@FluentIcons.Copy"/>
                <Button Icon="@FluentIcons.ClipboardPaste"/>
            </ButtonGroup>
            <ButtonGroup>
                <Button Icon="@FluentIcons.Cut"
                        Appearance="ButtonAppearance.Primary"/>
                <Button Icon="@FluentIcons.Copy"
                        Appearance="ButtonAppearance.Primary"/>
                <Button Icon="@FluentIcons.ClipboardPaste" Appearance="ButtonAppearance.Primary"/>
            </ButtonGroup>
            <ButtonGroup>
                <Button Icon="@FluentIcons.Cut"
                        Appearance="ButtonAppearance.Outline"/>
                <Button Icon="@FluentIcons.Copy"
                        Appearance="ButtonAppearance.Outline"/>
                <Button Icon="@FluentIcons.ClipboardPaste" Appearance="ButtonAppearance.Outline"/>
            </ButtonGroup>
            <ButtonGroup>
                <Button Icon="@FluentIcons.Cut"
                        Appearance="ButtonAppearance.Subtle"/>
                <Button Icon="@FluentIcons.Copy"
                        Appearance="ButtonAppearance.Subtle"/>
                <Button Icon="@FluentIcons.ClipboardPaste" Appearance="ButtonAppearance.Subtle"/>
            </ButtonGroup>
            <ButtonGroup>
                <Button Icon="@FluentIcons.Cut"
                        Appearance="ButtonAppearance.Transparent"/>
                <Button Icon="@FluentIcons.Copy"
                        Appearance="ButtonAppearance.Transparent"/>
                <Button Icon="@FluentIcons.ClipboardPaste"
                        Appearance="ButtonAppearance.Transparent"/>
            </ButtonGroup>
        </div>
    </div>

    <div>
        <h5>Dropdown button</h5>
        <div class="d-flex mb-3 gap-2 align-items-center">
            <Button Text="Default" Icon="@FluentIcons.CursorClick">
                <Dropdown>
                    <MenuList>
                        <MenuItem Title="Cut" Icon="@FluentIcons.Cut" Checked/>
                        <MenuItem Title="Copy" Icon="@FluentIcons.Copy"/>
                        <MenuItem Title="Paste" Icon="@FluentIcons.ClipboardPaste"/>
                    </MenuList>
                </Dropdown>
            </Button>
            <Button Text="Default" Icon="@FluentIcons.CursorClick" disabled>
                <Dropdown>
                    <MenuList>
                        <MenuItem Title="Cut" Icon="@FluentIcons.Cut" Checked/>
                        <MenuItem Title="Copy" Icon="@FluentIcons.Copy"/>
                        <MenuItem Title="Paste" Icon="@FluentIcons.ClipboardPaste"/>
                    </MenuList>
                </Dropdown>
            </Button>
        </div>
    </div>

    <div>
        <h5>Split button</h5>
        <div class="d-flex mb-3 gap-2 align-items-center">
            <Button Text="Default" Icon="@FluentIcons.CursorClick"
                    OnClick="()=>{}">
                <Dropdown>
                    <MenuList>
                        <MenuItem Title="Cut" Icon="@FluentIcons.Cut" Checked/>
                        <MenuItem Title="Copy" Icon="@FluentIcons.Copy"/>
                        <MenuItem Title="Paste" Icon="@FluentIcons.ClipboardPaste"/>
                    </MenuList>
                </Dropdown>
            </Button>
            <Button Text="Default" Icon="@FluentIcons.CursorClick"
                    OnClick="()=>{}" disabled>
                <Dropdown>
                    <MenuList>
                        <MenuItem Title="Cut" Icon="@FluentIcons.Cut" Checked/>
                        <MenuItem Title="Copy" Icon="@FluentIcons.Copy"/>
                        <MenuItem Title="Paste" Icon="@FluentIcons.ClipboardPaste"/>
                    </MenuList>
                </Dropdown>
            </Button>
        </div>
    </div>
</div>

@code {
}
