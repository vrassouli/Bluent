@page "/components/labels"
@namespace Bluent.UI.Demo.Pages.Components
@using System.ComponentModel
@using System.ComponentModel.DataAnnotations

<div class="p-5 py-md-10 px-md-12">
    <div class="w-100 w-md-50 m-auto">
        <h1>Label</h1>
        <p>Labels identify form controls. Required and disabled appearance on Label is visual only; the associated input owns its actual validation and disabled behavior.</p>

        <h3>Default</h3>
        <section class="p-7 rounded-5 shadow-3">
            <Label Text="This is a label" />
        </section>

        <h3>Size</h3>
        <section class="p-7 rounded-5 shadow-3">
            <div class="d-flex justify-content-evenly">
                <Label Text="Small" Size="LabelSize.Small" />
                <Label Text="Medium" Size="LabelSize.Medium" />
                <Label Text="Large" Size="LabelSize.Large" />
            </div>
        </section>

        <h3>Required</h3>
        <section class="p-7 rounded-5 shadow-3">
            <div class="d-flex justify-content-evenly">
                <Label ForExpression="() => RequiredProperty" Required="LabelRequiredState.Auto" />
                <Label Text="Explicitly required" Required="LabelRequiredState.Required" />
                <Label Text="Not required" Required="LabelRequiredState.NotRequired" />
            </div>
        </section>

        <h3>Input association and native validation</h3>
        <section class="p-7 rounded-5 shadow-3">
            <div class="mb-3">
                <Label Text="Email address" for="label-demo-email" Required="LabelRequiredState.Required" />
                <input id="label-demo-email" class="form-control" type="email" required />
            </div>
            <p class="mb-0">The Label displays the required marker. The input's native <code>required</code> attribute performs validation.</p>
        </section>

        <h3>Disabled visual state</h3>
        <section class="p-7 rounded-5 shadow-3">
            <Label Text="Disabled field" for="label-demo-disabled" disabled />
            <input id="label-demo-disabled" class="form-control" disabled value="Disabled input" />
            <p class="mb-0 mt-2">The input is disabled explicitly; the Label's <code>disabled</code> attribute only changes its visual style.</p>
        </section>

        <h3>Info content and accessible name</h3>
        <section class="p-7 rounded-5 shadow-3">
            <Label Text="Billing address" InfoButtonAriaLabel="Billing address help">
                <Info>
                    <p class="mb-2">Use the address associated with the payment method.</p>
                    <Link Text="Address requirements" href="https://www.microsoft.com/design/fluent/" />
                </Info>
            </Label>
            <p class="mt-3 mb-0">Activate the information button with Enter or Space. Focus moves into the content; Escape closes it and returns focus to the button. Tab can move to links inside the content.</p>
        </section>

        <h3>RTL</h3>
        <section class="p-7 rounded-5 shadow-3" dir="rtl">
            <Label Text="نشانی صورت‌حساب" Required="LabelRequiredState.Required">
                <Info>
                    <p class="mb-0">نشانی باید با اطلاعات روش پرداخت مطابقت داشته باشد.</p>
                </Info>
            </Label>
        </section>
    </div>
</div>

@code {
    [DisplayName("Required field")]
    [Required]
    public string RequiredProperty { get; set; } = string.Empty;
}
