@using Microsoft.AspNetCore.Components.Routing
@inject NavigationManager Navigation

<nav class="demo-nav @(Expanded ? "expanded" : "compact")" aria-label="Demo navigation">
    <div class="primary-links">
        <TabList Appearance="TabListAppearance.Subtle" Size="TabListSize.Small" Orientation="Orientation.Vertical">
            <Tab Text="@Label("Home")" Icon="@FluentIcons.Home" Href="@Navigation.BaseUri" Match="NavLinkMatch.All" Orientation="Orientation.Vertical" />
            <Tab Text="@Label("Getting started")" Icon="@FluentIcons.BookOpen" Href="getting-started" Orientation="Orientation.Vertical" />
            <Tab Text="@Label("Charts")" Icon="@FluentIcons.ChartMultiple" Href="components/charts" Orientation="Orientation.Vertical" />
            <Tab Text="@Label("Diagrams")" Icon="@FluentIcons.Diagram" Href="components/diagrams" Orientation="Orientation.Vertical" />
        </TabList>
    </div>

    <section class="nav-group">
        @if (Expanded)
        {
            <h2 class="nav-group-title">Enterprise scenarios</h2>
        }
        <TabList Appearance="TabListAppearance.Subtle" Size="TabListSize.Small" Orientation="Orientation.Vertical">
            <Tab Text="@Label("Customer profile")" Icon="@FluentIcons.PersonEdit" Href="scenarios/customer-profile" Orientation="Orientation.Vertical" />
            <Tab Text="@Label("Operations dashboard")" Icon="@FluentIcons.DataTrending" Href="scenarios/operations-dashboard" Orientation="Orientation.Vertical" />
            <Tab Text="@Label("Confirmation flow")" Icon="@FluentIcons.ShieldTask" Href="scenarios/confirmation-flow" Orientation="Orientation.Vertical" />
        </TabList>
    </section>

    <section class="nav-group">
        @if (Expanded)
        {
            <h2 class="nav-group-title">Actions</h2>
        }
        <TabList Appearance="TabListAppearance.Subtle" Size="TabListSize.Small" Orientation="Orientation.Vertical">
        <Tab Text="@Label("Buttons")" Icon="@FluentIcons.Button" Href="components/buttons" Orientation="Orientation.Vertical" />
        <Tab Text="@Label("Links")" Icon="@FluentIcons.Link" Href="components/links" Orientation="Orientation.Vertical" />
        <Tab Text="@Label("Toolbars")" Icon="@FluentIcons.Apps" Href="components/toolbars" Orientation="Orientation.Vertical" />
        </TabList>
    </section>

    <section class="nav-group">
        @if (Expanded)
        {
            <h2 class="nav-group-title">Inputs and forms</h2>
        }
        <TabList Appearance="TabListAppearance.Subtle" Size="TabListSize.Small" Orientation="Orientation.Vertical">
        <Tab Text="@Label("Fields")" Icon="@FluentIcons.TextField" Href="components/fields" Orientation="Orientation.Vertical" />
        <Tab Text="@Label("Checkboxes")" Icon="@FluentIcons.CheckboxChecked" Href="components/checkboxes" Orientation="Orientation.Vertical" />
        <Tab Text="@Label("Radio")" Icon="@FluentIcons.RadioButton" Href="components/radios" Orientation="Orientation.Vertical" />
        <Tab Text="@Label("Dropdowns")" Icon="@FluentIcons.ListBarTree" Href="components/dropdowns" Orientation="Orientation.Vertical" />
        <Tab Text="@Label("Calendar")" Icon="@FluentIcons.Calendar" Href="components/calendars" Orientation="Orientation.Vertical" />
        <Tab Text="@Label("Sliders")" Icon="@FluentIcons.LineFlowDiagonalUpRight" Href="components/sliders" Orientation="Orientation.Vertical" />
        <Tab Text="@Label("File selects")" Icon="@FluentIcons.Attach" Href="components/file-selects" Orientation="Orientation.Vertical" />
        </TabList>
    </section>

    <section class="nav-group">
        @if (Expanded)
        {
            <h2 class="nav-group-title">Navigation</h2>
        }
        <TabList Appearance="TabListAppearance.Subtle" Size="TabListSize.Small" Orientation="Orientation.Vertical">
        <Tab Text="@Label("Breadcrumbs")" Icon="@FluentIcons.DocumentChevronDouble" Href="components/breadcrumbs" Orientation="Orientation.Vertical" />
        <Tab Text="@Label("Menus")" Icon="@FluentIcons.TextBulletListSquare" Href="components/menus" Orientation="Orientation.Vertical" />
        <Tab Text="@Label("Tab lists")" Icon="@FluentIcons.TabDesktop" Href="components/tablists" Orientation="Orientation.Vertical" />
        <Tab Text="@Label("Trees")" Icon="@FluentIcons.TextBulletListTree" Href="components/trees" Orientation="Orientation.Vertical" />
        <Tab Text="@Label("Wizards")" Icon="@FluentIcons.SlideTextSparkle" Href="components/wizards" Orientation="Orientation.Vertical" />
        </TabList>
    </section>

    <section class="nav-group">
        @if (Expanded)
        {
            <h2 class="nav-group-title">Feedback and overlays</h2>
        }
        <TabList Appearance="TabListAppearance.Subtle" Size="TabListSize.Small" Orientation="Orientation.Vertical">
        <Tab Text="@Label("Dialogs")" Icon="@FluentIcons.Window" Href="components/dialogs" Orientation="Orientation.Vertical" />
        <Tab Text="@Label("Drawers")" Icon="@FluentIcons.SlideArrowRight" Href="components/drawers" Orientation="Orientation.Vertical" />
        <Tab Text="@Label("Message bars")" Icon="@FluentIcons.Info" Href="components/message-bars" Orientation="Orientation.Vertical" />
        <Tab Text="@Label("Popovers")" Icon="@FluentIcons.TooltipQuote" Href="components/popovers" Orientation="Orientation.Vertical" />
        <Tab Text="@Label("Toasts")" Icon="@FluentIcons.AlertUrgent" Href="components/toasts" Orientation="Orientation.Vertical" />
        <Tab Text="@Label("Tooltips")" Icon="@FluentIcons.TooltipQuote" Href="components/tooltips" Orientation="Orientation.Vertical" />
        </TabList>
    </section>

    <section class="nav-group">
        @if (Expanded)
        {
            <h2 class="nav-group-title">Data display</h2>
        }
        <TabList Appearance="TabListAppearance.Subtle" Size="TabListSize.Small" Orientation="Orientation.Vertical">
        <Tab Text="@Label("Data grids")" Icon="@FluentIcons.Grid" Href="components/data-grids" Orientation="Orientation.Vertical" />
        <Tab Text="@Label("Data pagers")" Icon="@FluentIcons.ArrowFit" Href="components/data-pagers" Orientation="Orientation.Vertical" />
        <Tab Text="@Label("Lists")" Icon="@FluentIcons.List" Href="components/lists" Orientation="Orientation.Vertical" />
        <Tab Text="@Label("Cards")" Icon="@FluentIcons.CardUi" Href="components/cards" Orientation="Orientation.Vertical" />
        </TabList>
    </section>

    <section class="nav-group">
        @if (Expanded)
        {
            <h2 class="nav-group-title">Layout</h2>
        }
        <TabList Appearance="TabListAppearance.Subtle" Size="TabListSize.Small" Orientation="Orientation.Vertical">
        <Tab Text="@Label("Dock panels")" Icon="@FluentIcons.LayoutColumnTwoSplitLeft" Href="components/dock-panels" Orientation="Orientation.Vertical" />
        <Tab Text="@Label("Split panels")" Icon="@FluentIcons.SplitHint" Href="components/split-panels" Orientation="Orientation.Vertical" />
        <Tab Text="@Label("Stacks")" Icon="@FluentIcons.StackVertical" Href="components/stacks" Orientation="Orientation.Vertical" />
        </TabList>
    </section>

    <section class="nav-group">
        @if (Expanded)
        {
            <h2 class="nav-group-title">Status and visuals</h2>
        }
        <TabList Appearance="TabListAppearance.Subtle" Size="TabListSize.Small" Orientation="Orientation.Vertical">
        <Tab Text="@Label("Avatars")" Icon="@FluentIcons.PersonCircle" Href="components/avatars" Orientation="Orientation.Vertical" />
        <Tab Text="@Label("Badges")" Icon="@FluentIcons.Badge" Href="components/badges" Orientation="Orientation.Vertical" />
        <Tab Text="@Label("Icons")" Icon="@FluentIcons.Icons" Href="components/icons" Orientation="Orientation.Vertical" />
        <Tab Text="@Label("Labels")" Icon="@FluentIcons.TagCircle" Href="components/labels" Orientation="Orientation.Vertical" />
        <Tab Text="@Label("Tags")" Icon="@FluentIcons.Tag" Href="components/tags" Orientation="Orientation.Vertical" />
        <Tab Text="@Label("Progress bars")" Icon="@FluentIcons.Apps" Href="components/progress-bars" Orientation="Orientation.Vertical" />
        <Tab Text="@Label("Skeletons")" Icon="@FluentIcons.Apps" Href="components/skeletons" Orientation="Orientation.Vertical" />
        <Tab Text="@Label("Spinners")" Icon="@FluentIcons.SpinnerIos" Href="components/spinners" Orientation="Orientation.Vertical" />
        </TabList>
    </section>

    <section class="nav-group">
        @if (Expanded)
        {
            <h2 class="nav-group-title">Rich capabilities</h2>
        }
        <TabList Appearance="TabListAppearance.Subtle" Size="TabListSize.Small" Orientation="Orientation.Vertical">
        <Tab Text="@Label("Drawing")" Icon="@FluentIcons.DrawImage" Href="components/drawing-canvases" Orientation="Orientation.Vertical" />
        </TabList>
    </section>
</nav>

@code {
    [Parameter] public bool Expanded { get; set; }

    private string Label(string value) => Expanded ? value : string.Empty;
}
