@namespace Bluent.UI.Components
@inherits BluentInputComponentBase<TValue?>
@typeparam TValue

<fieldset @attributes="GetGroupAdditionalAttributes()" id="@Id" class="@GetComponentClass()" style="@Style">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <legend class="group-label">@Label</legend>
    }
    <div class="items-list">
        <CascadingValue Value="this" IsFixed>
            @ChildContent
        </CascadingValue>
    </div>
</fieldset>
