@namespace Bluent.UI.Components
@inherits BluentUiComponentBase
@typeparam TValue

<div class="@GetComponentClass()" style="@Style">
    <input @attributes="GetInputAdditionalAttributes()"
           type="radio"
           name="@RadioGroup.RadioGroupName"
           value="@GetInputValue()"
           checked="@IsChecked"
           id="@Id"
           @onchange="HandleOnChange" />
    <label class="indicator" for="@Id" aria-hidden="true"></label>
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="option-label" for="@Id">@Label</label>
    }
</div>
