<div class="title">
    @if (Intend != ToastIntend.None)
    {
        <Icon Value="@GetIcon()" Variant="IconVariant.Filled" Class="@GetIconClass()" />
    }
    <div class="text">@Title</div>
    @if (!string.IsNullOrEmpty(DismissTitle))
    {
        <Link Text="@DismissTitle" Class="dismiss" OnClick="OnDismissClick" />
    }
</div>
@if (!string.IsNullOrEmpty(Message))
{
    <div class="message">@Message</div>
}

@code {
    [Parameter] public string Title { get; set; } = default!;
    [Parameter] public string? Message { get; set; }
    [Parameter] public string? DismissTitle { get; set; }
    [Parameter] public ToastIntend Intend { get; set; } = ToastIntend.None;
    [CascadingParameter] public Toast? Toast{ get; set; }

    private IconDefinition GetIcon() => Intend switch
    {
        ToastIntend.Success => FluentIcons.CheckmarkCircle,
        ToastIntend.Info => FluentIcons.Info,
        ToastIntend.Warning => FluentIcons.Warning,
        ToastIntend.Error => FluentIcons.DismissCircle,
        _ => FluentIcons.Info
    };

    private string GetIconClass() => Intend switch
    {
        ToastIntend.Success => "color-success-1 me-2",
        ToastIntend.Info => "color-info-1 me-2",
        ToastIntend.Warning => "color-warning-1 me-2",
        ToastIntend.Error => "color-danger-1 me-2",
        _ => "me-2"
    };

    private void OnDismissClick()
    {
        Toast?.Close(null);
    }
}
