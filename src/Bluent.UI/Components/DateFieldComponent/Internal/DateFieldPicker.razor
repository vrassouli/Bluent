@using System.Globalization
@using Microsoft.Extensions.Localization
@typeparam TValue

<Popover AccessibleTriggerState="true"
         Placement="Placement.BottomStart"
         DisplayArrow="false"
         SurfaceRole="dialog"
         SurfaceAriaLabelledBy="@_calendarHeadingId">
    <Trigger>
        <Button Icon="@FluentIcons.Calendar"
                Appearance="ButtonAppearance.Subtle"
                Size="ButtonSize"
                Class="datefield-calendar-trigger"
                aria-label="@Localizer["ChooseDate"]"
                aria-haspopup="dialog"
                disabled="@IsDisabled" />
    </Trigger>
    <Surface>
        <div class="datefield-calendar-popup @CalendarModeClass">
            <Calendar Id="@_calendarId" TValue="TValue"
                      SelectedDate="_value"
                      SelectedDateChanged="OnDatePicked"
                      Culture="Culture"
                      Mode="Mode"
                      Min="Min"
                      Max="Max"
                      DateClass="DateClass"
                      Class="datefield-calendar" />
            @if (Mode == CalendarMode.DaySelect && SelectedDateForDisplay is { } selectedDate)
            {
                <div class="datefield-calendar-selected-date">@selectedDate.ToString("d MMMM yyyy", Culture)</div>
            }
        </div>
    </Surface>
</Popover>

@code {
    private TValue? _value;
    private readonly string _calendarId = $"datefield-calendar-{Guid.NewGuid():N}";
    private string _calendarHeadingId => $"{_calendarId}-heading";
    private string CalendarModeClass => Mode switch
    {
        CalendarMode.MonthSelect => "month-select",
        CalendarMode.YearSelect => "year-select",
        _ => "day-select"
    };
    private DateTime? SelectedDateForDisplay => _value switch
    {
        DateTime dateTime => dateTime,
        DateOnly dateOnly => dateOnly.ToDateTime(TimeOnly.MinValue),
        _ => null
    };

    [Parameter, EditorRequired] public ButtonSize ButtonSize { get; set; }
    [Parameter, EditorRequired] public bool IsDisabled { get; set; }
    [Parameter, EditorRequired] public CultureInfo Culture { get; set; } = default!;
    [Parameter, EditorRequired] public TValue? Value { get; set; }
    [Parameter, EditorRequired] public EventCallback<TValue> OnDatePicked { get; set; }
    [Parameter, EditorRequired] public CalendarMode Mode { get; set; }
    [Parameter, EditorRequired] public DateTime? Min { get; set; }
    [Parameter, EditorRequired] public DateTime? Max { get; set; }
    [CascadingParameter(Name = "BluentDateFieldDateClass")]
    private Func<DateOnly, string>? DateClass { get; set; }
    [Inject] private IStringLocalizer<DateFieldComponent.Resources.DateField> Localizer { get; set; } = default!;

    protected override void OnParametersSet()
    {
        if (!EqualityComparer<TValue?>.Default.Equals(_value, Value))
            _value = Value;

        base.OnParametersSet();
    }
}
