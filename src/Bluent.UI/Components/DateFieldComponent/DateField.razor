@namespace Bluent.UI.Components
@inherits BluentFieldComponentBase<TValue>
@typeparam TValue

<CascadingValue TValue="string" Name="BluentDateFieldBindValueEvent" Value="@BindValueEvent">
<MaskedField Mask="@GetMask()"
             StartAddon="StartAddon"
             EndAddon="GetEndAddon()"
             Size="Size"
             Class="@Class"
             Style="@Style"
             @bind-Value="CurrentValueAsString"
             AsciiDigits="true"
             @attributes="GetInputAdditionalAttributes()"
             id="@GetInputId()"
             dir="ltr"
             autocomplete="off"
             name="@NameAttributeValue" />
</CascadingValue>
