@namespace Bluent.UI.Components
@inherits BluentUiComponentBase

<div @attributes=AdditionalAttributes id="@Id" class="@GetComponentClass()" style="@Style">
    <div class="@GetHeaderClasses()" @onclick="ClickHandler">
        <div class="expander">
            <Icon Value="@FluentIcons.ChevronRight" />
        </div>
        @if (HeaderIcon.HasValue)
        {
            <Icon Value="@HeaderIcon" Class="icon" />
        }
        <div class="title"><span>@Header</span></div>
        @if (HeaderAction != null)
        {
            <div class="action">@HeaderAction</div>
        }
    </div>
    @if (!DeferredLoading || Expanded)
    {
        <div class="panel @PanelClasses">
            <CascadingValue Value="this" IsFixed>
                @ChildContent
            </CascadingValue>
        </div>
    }
</div>
