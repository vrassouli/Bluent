<div class="dialog-content">
    <div class="header">
        <h2 class="title" id="@(Dialog?.UseStandardTitleHeading == true ? Dialog.AccessibleHeadingId : null)">@(_draftTitle ?? Title)</h2>
        @if (ShowCloseButton)
        {
            <Button Appearance="ButtonAppearance.Transparent"
                    Icon="@FluentIcons.Dismiss"
                    aria-label="@Dialog?.CloseButtonLabel"
                    Size="ButtonSize.Large"
                    Class="fs-4"
                    OnClick="CloseHandler" />
        }
    </div>
    <div class="content">
        @if (Dialog?.UseStandardTitleHeading == true && !string.IsNullOrWhiteSpace(Dialog.AccessibleDescription))
        {
            <p class="bui-v3-dialog-description" id="@Dialog.AccessibleDescriptionId">@Dialog.AccessibleDescription</p>
        }
        @if (Dialog?.UseStandardTitleHeading == true)
        {
            <CascadingValue Value="(Action<string>)ChangeV3Title" Name="V3DialogTitleUpdate" IsFixed>
                <DynamicComponent Type="ContentComponentType" Parameters="ContentParameters" />
            </CascadingValue>
        }
        else
        {
            <DynamicComponent Type="ContentComponentType" Parameters="ContentParameters" />
        }
    </div>
    @if (Actions.Any())
    {
        <div class="actions">
            @foreach (var action in Actions)
            {
                <Button Text="@action.Text"
                        Appearance="@(action.Primary ? ButtonAppearance.Primary : ButtonAppearance.Default)"
                        OnClick="()=>{ OnActionClick(action); }"
                        form="@action.FormToSubmit"
                        type="@(string.IsNullOrEmpty(action.FormToSubmit) ? "button" : "submit")" />
            }
        </div>
    }
</div>

@code {
    private string? _draftTitle;
    // An experimental opt-in cascading callback, intentionally absent
    // from the public DialogConfigurator and from legacy render paths.
    private void ChangeV3Title(string title)
    {
        if (Dialog?.UseStandardTitleHeading != true || string.IsNullOrWhiteSpace(title))
            return;
        _draftTitle = title;
        _ = InvokeAsync(StateHasChanged);
    }
    [Parameter] public Type ContentComponentType { get; set; } = default!;
    [Parameter] public IDictionary<string, object?>? ContentParameters { get; set; }
    [Parameter] public string Title { get; set; } = default!;
    [Parameter] public bool ShowCloseButton { get; set; } = true;
    [Parameter] public IEnumerable<DialogAction> Actions { get; set; } = Enumerable.Empty<DialogAction>();
    [CascadingParameter] public Dialog? Dialog { get; set; }

    private void CloseHandler()
    {
        Dialog?.Close();
    }

    private void OnActionClick(DialogAction action)
    {
        if (!string.IsNullOrEmpty(action.FormToSubmit))
            return;
        else if (action.Callback != null && Dialog != null)
            action.Callback(Dialog, action.Result);
        else if (Dialog != null)
            Dialog.Close(action.Result);
    }
}
