@namespace Bluent.UI.Components
@inherits BluentUiComponentBase

<div @ref="_root" @attributes=AdditionalAttributes id="@Id"
     tabindex="@(string.IsNullOrWhiteSpace(AccessibleName) ? null : "-1")" class="@GetComponentClass()" style="@Style"
     role="@(string.IsNullOrWhiteSpace(AccessibleName) ? null : "dialog")"
     aria-label="@(UseStandardTitleHeading ? null : AccessibleName)"
     aria-labelledby="@(UseStandardTitleHeading && !string.IsNullOrWhiteSpace(AccessibleName) ? AccessibleHeadingId : null)"
     aria-describedby="@(!string.IsNullOrWhiteSpace(AccessibleName) && !string.IsNullOrWhiteSpace(AccessibleDescription) ? AccessibleDescriptionId : null)"
     aria-modal="@(string.IsNullOrWhiteSpace(AccessibleName) || !IsModal ? null : "true")"
     data-bui-v3-keyboard-modal="@(EnableModalKeyboard && IsModal && !string.IsNullOrWhiteSpace(AccessibleName) ? "" : null)"
     @onanimationend="AnimationEndedHandler">
    @if (!UseStandardTitleHeading && !string.IsNullOrWhiteSpace(AccessibleName) && !string.IsNullOrWhiteSpace(AccessibleDescription))
    {
        <p class="bui-v3-dialog-description" id="@AccessibleDescriptionId">@AccessibleDescription</p>
    }
    <CascadingValue Value="this" IsFixed>
        @ChildContent
    </CascadingValue>
</div>