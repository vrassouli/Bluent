@namespace Bluent.UI.Components
@inherits BluentUiComponentBase

<li @attributes=AdditionalAttributes id="@Id" class="@GetComponentClass()" style="@Style">
    <a href="@Href" target="@Target">
        @if (Icon.HasValue)
        {
            @if (Icon.Value.Filled.HasValue)
            {
                <Icon Class="active-icon" Value="@Icon" Variant="IconVariant.Filled" />
            }
            <Icon Class="icon" Value="@Icon"/>
        }
        <div class="title">
            @Title
        </div>
    </a>
</li>
@if (!IsCurrent)
{
    <li class="seperator">
        <Icon Class="icon" Value="@FluentIcons.ChevronRight" />
    </li>
}