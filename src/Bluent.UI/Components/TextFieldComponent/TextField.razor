@namespace Bluent.UI.Components
@inherits BluentFieldComponentBase<string?>

<div class="@GetComponentClass()" style="@Style">
    @if (StartAddon != null)
    {
        <div class="start-addon">
            @StartAddon
        </div>
    }

    @if (Rows == null)
    {
        <input @attributes=GetTextFieldAdditionalAttributes()
               @ref=Element
               id="@GetInputId()"
               name="@NameAttributeValue"
               @bind-value="ValueStringProxy"
               @bind-value:event="@BindValueEvent"
               @bind-value:after="OnValueBoundAsync" />
    }
    else
    {
        <textarea @attributes=GetTextFieldAdditionalAttributes()
                  @ref=Element
                  id="@GetInputId()"
                  name="@NameAttributeValue"
                  rows="@Rows"
                  @bind-value="ValueStringProxy"
                  @bind-value:event="@BindValueEvent"
                  @bind-value:after="OnValueBoundAsync"></textarea>
    }

    @if (EndAddon != null)
    {
        <div class="end-addon">
            @EndAddon
        </div>
    }
</div>
