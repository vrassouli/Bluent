@namespace Bluent.UI.Components
@inherits BluentUiComponentBase

@if (_dismissed)
    return;

<div @attributes=AdditionalAttributes id="@Id" class="@GetComponentClass()" style="@Style">
    <div class="icon">
        <Icon Value="@GetIcon()" Variant="IconVariant.Filled" />
    </div>
    <div class="body">
        @ChildContent
    </div>
    @if (Dismissable)
    {
        <div class="dismiss">
            <Button Appearance="ButtonAppearance.Transparent"
                    Size="ButtonSize.Small"
                    Icon="@FluentIcons.Dismiss"
                    OnClick="HandleDismiss" />
        </div>
    }
    @if (Actions != null)
    {
        <div class="actions">
            @Actions
        </div>
    }
</div>
