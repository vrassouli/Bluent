<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>Bluent.UI.Charts</PackageId>
        <Title>Bluent UI Charts</Title>
        <Authors>Vahid Rassouli</Authors>
        <Description>Blazor chart components for Bluent business applications, powered by Chart.js.</Description>
        <PackageTags>Blazor;Charts;Chart.js;Components;Data Visualization;Business Applications</PackageTags>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/vrassouli/Bluent</PackageProjectUrl>
        <RepositoryUrl>https://github.com/vrassouli/Bluent.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="../../README.md" Pack="true" PackagePath="/" />
        <SupportedPlatform Include="browser" />
    </ItemGroup>

    <Target Name="PreBuild" BeforeTargets="Build" Condition="'$(Configuration)' == 'Debug'">
        <Copy
                SourceFiles="..\Bluent.UI.Charts.Scripts\dist\bluent.ui.charts.js"
                DestinationFolder="$(ProjectDir)wwwroot\"
                SkipUnchangedFiles="true" />
    </Target>

    <ItemGroup>
        <Folder Include="wwwroot\" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Humanizer.Core" Version="3.0.10" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Bluent.Core\Bluent.Core.csproj" />
    </ItemGroup>

</Project>
